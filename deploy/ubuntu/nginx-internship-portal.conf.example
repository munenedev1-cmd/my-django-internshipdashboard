# Install a certificate whose SAN includes both dvsinternship and 192.168.0.228,
# plus its private key, before enabling this site.
server {
    listen 80;
    server_name dvsinternship 192.168.0.228;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name dvsinternship 192.168.0.228;

    ssl_certificate     /etc/ssl/certs/internship-portal.crt;
    ssl_certificate_key /etc/ssl/private/internship-portal.key;

    client_max_body_size 22m;

    location /static/ {
        alias /opt/internship-portal/staticfiles/;
        access_log off;
        expires 7d;
    }

    # Do not add a public /media/ alias. Application documents are returned
    # only by Django's authenticated, owner/staff-checked download view.
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
