# Copy to /etc/internship-portal.env and replace every example value.
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=dvsinternship,192.168.0.228
CSRF_TRUSTED_ORIGINS=https://dvsinternship,https://192.168.0.228
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
# Set to 31536000 after HTTPS and the certificate are verified on all clients.
SECURE_HSTS_SECONDS=0
DATABASE_NAME=/var/lib/internship-portal/db.sqlite3
MEDIA_ROOT=/var/lib/internship-portal/media
